# systemd service for categor.io — see docs/DEPLOY.md.
# Install: cp deploy/categorio.service /etc/systemd/system/
[Unit]
Description=categor.io website
After=network.target

[Service]
User=categorio
Group=categorio
WorkingDirectory=/srv/categorio/app
EnvironmentFile=/etc/categorio.env
# One worker process (the site keeps state in memory), several threads.
ExecStart=/srv/categorio/venv/bin/gunicorn --workers 1 --threads 8 \
    --bind 127.0.0.1:8000 --timeout 120 --access-logfile - \
    "categorio:create_app()"
Restart=on-failure
RestartSec=3

# Hardening: the service can write only its data folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/categorio/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
